# Example Environment Configuration for ZAS
# Copy this file to .env and fill in your values

# ===================================
# Required: Zendesk Configuration
# ===================================
ZENDESK_SUBDOMAIN=your-subdomain
ZENDESK_EMAIL=your-email@example.com
ZENDESK_API_TOKEN=your-api-token

# ===================================
# Optional: Jira Configuration
# ===================================
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token

# ===================================
# Optional: Confluence Configuration
# ===================================
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_EMAIL=your-email@example.com
CONFLUENCE_API_TOKEN=your-api-token

# ===================================
# MCP Server Configuration
# ===================================
MCP_HOST=127.0.0.1
MCP_PORT=8000

# ===================================
# Chat API Configuration
# ===================================
CHAT_API_HOST=0.0.0.0
CHAT_API_PORT=3000

# ===================================
# MCP Proxy Configuration
# ===================================
MCP_PROXY_HOST=0.0.0.0
MCP_PROXY_PORT=8080

# ===================================
# Agent Configuration
# ===================================
ZAS_MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# ===================================
# Logging Configuration
# ===================================
ZAS_FEEDBACK_LOG=zas_feedback_log.jsonl

# ===================================
# API Configuration (Optional)
# ===================================
# API_TIMEOUT=20
# RATE_LIMIT_DELAY=0.15

# ===================================
# Telegram Notifications (Optional)
# ===================================
# TELEGRAM_ENABLED=true
# TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
# TELEGRAM_CHAT_ID=your-chat-id

# ===================================
# Dashboard Configuration
# ===================================
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000

# ===================================
# AI Orchestration (Optional)
# ===================================
# ORCHESTRATION_ENABLED=true
# NUM_EVALUATOR_AGENTS=3